# OpenAI 兼容接口，示例为阿里云百炼（通义千问）
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_TEMPERATURE=0.2

# Dify 知识库（dify-kb-search）— 方案 C：按名称选库
DIFY_BASE_URL=http://127.0.0.1:5001/v1
DIFY_API_KEY=dataset-xxxx
# 命名多库：名称:uuid,名称:uuid
DIFY_DATASETS=投诉口径:your-dataset-uuid,网络指标:another-dataset-uuid
# 未指定 dataset 时用哪个名称
DIFY_DATASET_DEFAULT=投诉口径
# 兼容旧单库（可选；不配 DIFY_DATASETS 时仍可用）
# DIFY_DATASET_ID=your-dataset-uuid

# Dify 周报/月报（chat-messages）。BASE 只写到 /v1，不要带 /chat-messages
DIFY_REPORT_BASE_URL=http://127.0.0.1/v1
DIFY_REPORT_API_KEY=app-xxxx
DIFY_REPORT_USER=complaint-agent
# 内网优先 blocking；Agent Chat 不支持时自动回退 streaming
DIFY_REPORT_RESPONSE_MODE=blocking
DIFY_REPORT_TIMEOUT_SEC=180

# LangSmith 可观测性（写入 os.environ，启动时由 load_dotenv 加载）
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxx
LANGSMITH_PROJECT=deepAgent-complaint
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 业务 PostgreSQL（投诉工单 / 方案库 / 重投归因，数据分析）
SCHEME_DB_URL=postgresql+psycopg2://postgres:123456@127.0.0.1:5432/yang
SCHEME_DB_SCHEME_TABLE=complaint_work_scheme_library
SCHEME_DB_COMPLAINT_TABLE=complaint_work_order
SCHEME_DB_CHONGTOU_TABLE=chongtou_root_cause_detail
SCHEME_DB_MAX_ROWS=100
SCHEME_DB_TIMEOUT_MS=60000
# 重投原因 3/4 类：派单间隔阈值（天）
CHONGTO_REPEAT_GAP_DAYS=3

# 发单表服务 BASE（只调已有 files/download；测试/生产改地址即可）
FADAN_API_BASE_URL=http://127.0.0.1:8002
FADAN_API_TIMEOUT_SEC=90
